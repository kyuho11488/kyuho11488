# 문제7. 시그모이드(Sigmoid) 함수의 1차 미분 함수를 구하고, Sigmoid 함수와 미분 함수를 같은 화면에 그려보라.

import numpy as np
import matplotlib.pyplot as plt

# Sigmoid 함수를 정의한다. 
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

# Sigmoid 미분 함수를 정의한다. 
def sigmoid_differentiation(x):
    return sigmoid(x) * (1 - sigmoid(x))

# x 값 범위를 설정한다. 
x = np.linspace(-10, 10, 100)

# y 값을 계산한다. 
y_sigmoid = sigmoid(x)
y_differentiation = sigmoid_differentiation(x)

# 그래프를 그린다. 
plt.figure(figsize=(8, 5))
plt.plot(x, y_sigmoid, label="Sigmoid Function", color='blue')
plt.plot(x, y_differentiation, label="Sigmoid Differentiation", color='red')

# 그래프를 꾸며준다. 
plt.axhline(y=0, color='black', linewidth=0.5) # h : horizontal
plt.axvline(x=0, color='black', linewidth=0.5) # v : vertical
plt.legend()
plt.title("Sigmoid Function and its Differentiation")
plt.xlabel("x")
plt.ylabel("value")
plt.grid()

# 그래프 출력
plt.show()
